# Public site origin for canonical URLs, sitemap, and robots.txt.
# Example: https://benchline.example
NEXT_PUBLIC_SITE_URL=

# SQLite file is the default locally (data/benchline.db).
# On Vercel the disk is ephemeral. Set Turso for reports that survive deploys.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Salt for hashed IP rate limits. Set a long random value in production.
RATE_LIMIT_SALT=

# Optional Cloudflare Turnstile. Both must be set for the widget to be required.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional AdSense. Slots stay labeled placeholders until both values exist.
# Never used to invent sponsored brands inside a report.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_REPORT=

# Optional live engine calls. If none of these are set, live checks are skipped.
# The citability crawl, prompt pack, and paste scorer do not need them.
# LIVE_CHECKS=off disables calls even when keys exist.
LIVE_CHECKS=
LIVE_CHECK_DAILY_QUOTA=15

# DataForSEO LLM Responses (ChatGPT models). One short prompt per report.
# https://docs.dataforseo.com/v3/ai_optimization/chat_gpt/llm_responses/live/
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_MODEL=gpt-4.1-mini
# Set to true only if you accept the extra cost of web search on that call.
DATAFORSEO_WEB_SEARCH=false

# OpenAI Chat Completions. This is not the consumer ChatGPT app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Brave AI Answers. Either name works.
# https://api.search.brave.com/res/v1/chat/completions
BRAVE_API_KEY=
BRAVE_SEARCH_API_KEY=
